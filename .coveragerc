[run]
# Specify which files to include in coverage
source = src
relative_files = True

# Files to omit from coverage
omit = 
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
    */build/*
    */dist/*
    setup.py

[report]
# Show missing lines in coverage report
show_missing = True

# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__:
    def .*:.*pass

[xml]
# Output file for XML coverage report (used by SonarCloud)
output = coverage.xml

[html]
# Directory for HTML coverage report (for local development)
directory = htmlcov
